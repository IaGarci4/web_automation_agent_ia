# ═════════════════════════════════════════════════════════════════════════════
#  web_automation_agent_ia — Plantilla de configuración
#  Copia este archivo a  ".env"  y rellena TUS valores.
#  El .env real NO se sube a git (está en .gitignore); este .env.example SÍ.
#  Reglas: contraseñas/secretos = NUNCA los reales aquí (usa placeholders).
#          URLs, testids y selectores públicos = sí pueden ir como referencia.
# ═════════════════════════════════════════════════════════════════════════════

# ── Ambiente ─────────────────────────────────────────────────────────────────
# test (default) | prod. Cambia los datos que dependen del ambiente
# (bill payment, etc.) vía settings.por_ambiente(). La GUI lo fija por corrida.
HERMES_ENV=test

# ── Portal objetivo ──────────────────────────────────────────────────────────
PORTAL_NAME=hermes2
# Las URLs de Hermes y Chronos se DERIVAN de HERMES_ENV (no hay que tocarlas):
#   test → test-hermes.maxilabs.net  ·  test-apps.maxilabs.net/Chronos
#   prod → hermes.maxiagentes.net    ·  corporateapp.maxiagentes.net
# Solo si quieres apuntar a OTRO portal (motor genérico), usa APP_URL_FORCE.
# APP_URL_FORCE=
READY_URL_PATTERN=

# ── Credenciales del PORTAL (Hermes) — PON LAS TUYAS, no las subas ───────────
# Opción A (simple): sirven para el ambiente que estés usando.
PORTAL_USER=tu_usuario_hermes
PORTAL_PASS=tu_password_hermes
PORTAL_USER_MULTI=tu_usuario_multiagente
PORTAL_PASS_MULTI=tu_password_multiagente

# Opción B (como el repo QA viejo): credenciales SEPARADAS por ambiente. Si
# defines estas y NO defines las de arriba, se elige según HERMES_ENV.
# MAXI_USER=            # test  · mono-agencia
# MAXI_PSWD=            # test  · contraseña
# MAXI_USER_M=          # test  · multi-agencia
# PROD_MAXI_USER=       # prod  · mono-agencia
# PROD_MAXI_PSWD=       # prod  · contraseña
# PROD_MAXI_USER_M=     # prod  · multi-agencia

# Agencia a operar. Si se omite: 0040-OK en test, 0020-TX en producción.
# AGENCY_CODE=0040-OK

# ── Chronos (back office) ───────────────────────────────────────────────────
# Necesario para CP07 (rechazo del cheque) y la fase Chronos de otros CP.
# El LOGIN CAMBIA POR AMBIENTE y se detecta solo:
#   TEST → formulario de Keycloak: usuario + contraseña (sin 2FA).
#   PROD → SSO de Google: correo Maxi + contraseña de Gmail + 2FA en el celular.
CHRONOS_USER=usuario_de_test
CHRONOS_PASS=contrasena_de_test
# PROD_CHRONOS_USER=tu_correo@maxillc.com
# PROD_CHRONOS_PASS=tu_password_de_gmail

# Forzar el método de login (por defecto 'auto', que lo detecta en pantalla).
# CHRONOS_LOGIN_MODE=auto        # auto | password | google
# Espera del home tras enviar credenciales (ms) y espera para aprobar el 2FA.
# CHRONOS_HOME_MS=30000
# CHRONOS_2FA_MS=120000

# ── Selectores de login (confirmados contra la pantalla real de Hermes2) ─────
LOGIN_USER_SELECTOR=input[name='username'], #username, input[type='email']
LOGIN_PASS_SELECTOR=#password
LOGIN_SUBMIT_SELECTOR=button[type='submit'], #login, button:has-text('Login')
LOGIN_USER_TESTID=login-form-username-input
LOGIN_PASS_TESTID=
LOGIN_SUBMIT_TESTID=login-form-submit-button
# Algo visible SOLO cuando ya entraste (mejora la detección de sesión).
READY_SELECTOR=[data-testid="user-navbar-item"]

# ── GUI (Streamlit) ──────────────────────────────────────────────────────────
# Contraseña del ADMIN de la GUI (banco de usuarios en gui/usuarios.json, que
# está gitignoreado). Es SOLO para entrar al agente, no es de ningún portal.
AGENT_ADMIN_PASSWORD=cambia_esta_password
# Puerto propio de la GUI (evita chocar con otros Streamlit).
GUI_PORT=8502

# ── Claude (OPCIONAL) ────────────────────────────────────────────────────────
# Si la defines, el agente NL y la base de conocimiento usan Claude para
# respuestas más ricas. Vacía = modo offline (matching local + memoria).
ANTHROPIC_API_KEY=

# ── Playwright ───────────────────────────────────────────────────────────────
PW_HEADLESS=false
PW_SLOW_MO=0
PW_VIDEO=false

# ── Timeouts (ms) — Hermes TEST es impredecible, techo amplio ────────────────
TIMEOUT_NAVIGATION=90000
TIMEOUT_ELEMENT=90000
TIMEOUT_SHORT=5000
TIMEOUT_MODAL=90000
TIMEOUT_READY=10000
TIMEOUT_2FA=180000

# ── Ajustes de ejecución (los usan los tests / la GUI los fija por corrida) ──
COMPLETAR_ENVIO=1          # 1 = completa el envío/pago; 0 = solo arma el formulario
FLOW_CANCEL=0              # 1 = cancela al final (la GUI/el agente lo controlan)
FLOW_TYPE=cash            # cash | deposit | home | mobile | atm
# FLOW_LANG lo inyecta la GUI (en|es) para navegar Hermes en ese idioma; no
# suele fijarse a mano. FLOW_OVERRIDES lo arma el agente desde lenguaje natural.

# ── Pausas / tiempos finos (opcionales, tienen buen default) ─────────────────
SUCCESS_PAUSE_MS=1500      # deja visible el modal de éxito antes del 'No'
CANCEL_PAUSE_MS=10000      # espera para visualizar la cancelación (bill payment)
IA_MODAL_TIMEOUT_MS=120000 # espera del modal de Información Adicional (compliance)
KRA_PAUSE_MS=5000          # pausa para visualizar la corrección del teléfono (KRA-1125)

# ═════════════════════════════════════════════════════════════════════════════
# OVERRIDES OPCIONALES POR CASO (todos tienen default; descomenta para cambiar)
# ─────────────────────────────────────────────────────────────────────────────
# CP01_PAYER=SORIANA
# CP01_AMOUNT=20
# CP01_CANCELAR=1
# CP02_PAYER=WALMART
# CP02_AMOUNT=310
# CP02_CANCELAR=1
# CP03_PAYER=BANCOLOMBIA_DIRECTO
# CP03_AMOUNT=3000
# CP03_ACCOUNT=88888888888
# CP03_CANCELAR=1
# CP04_PAYER=MASTERCARD CASH PICK-UP
# CP04_AMOUNT=20
# CP04_CANCELAR=1
# CP05_PHONE=5435345345
# CP05_BILLER=AMERIGAS
# CP05_ACCOUNT=123456789
# CP05_ZIP=22222
# CP05_CANCELAR=1
# CP06_PHONE=5435345345
# CP06_CANCELAR=1
# CP07_MEGA=1                 # correr el sub-flujo Mega Top Ups
# CP07_REGULAR=1              # correr el sub-flujo Top Ups regular
# CP07_MEGA_PHONE=3322313245
# CP07_MEGA_AMOUNT=$2
# CP07_BENEF_PHONE=3322313245
# CP07_CUST_PHONE=7774533317

# ── QMetry (Test Management for Jira) — evidencias del sanity ───────────────
# API Key: en Jira → QMetry > Configuration > Open API > Generate.
QMETRY_API_KEY=tu_api_key_de_qmetry
QMETRY_BASE_URL=https://qtmcloud.qmetry.com
QMETRY_PROJECT_ID=10030
QMETRY_PROJECT_KEY=BM
# Test Cycle donde se guardan las evidencias (por ambiente si se omite:
#   test → BM-TR-1370 'Sanity General TEST' · prod → BM-TR-1412 'Sanity General PROD')
# QMETRY_TEST_CYCLE=BM-TR-1370
# ── SWITCH MAESTRO de la integración con QMetry ─────────────────────────────
# La lógica está integrada en TODOS los casos del sanity, pero APAGADA: con 0
# no se sube absolutamente nada. Ponlo en 1 cuando se necesite (o usa la
# casilla de la GUI / `$env:QMETRY_UPLOAD="1"` para una sola corrida).
# Si el caso falla, no se sube nada aunque esté encendido.
QMETRY_UPLOAD=0
# Escribir también el resultado Pass/Fail en el ciclo (1 = sí).
# Usa el veredicto REAL de la prueba, no la existencia de la imagen.
QMETRY_RESULTADO=0
# Solo si tu tenant exige además el Basic auth de Jira:
# QMETRY_JIRA_EMAIL=tu_correo@maxillc.com
# QMETRY_JIRA_TOKEN=tu_api_token_de_atlassian

# ── KRA-1527 · Hardware Agent y volcados de memoria ─────────────────────────
# Procesos objetivo del volcado (los del agente de escritorio de Hermes).
# HW_AGENT_PROC=Hermes2Agent.exe
# HW_PROXY_PROC=Maxi.RulesOffice.Security.HttpProxy.exe
# procdump (Sysinternals). Si no existe, la auditoría de tráfico corre igual y
# el volcado se reporta como 'no realizado' — nunca como aprobado.
# PROCDUMP_PATH=C:\Tools\Sysinternals\procdump.exe
# DUMP_OUT_DIR=%TEMP%
# Qué URLs se consideran llamada al agente (vive en la máquina local).
# HW_AGENT_URL_PATTERN=localhost|127\.0\.0\.1|\[::1\]
# Poner en 0 para auditar solo el tráfico, sin volcar memoria.
KRA1527_DUMP=1
